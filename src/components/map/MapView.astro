---
// src/components/map/MapView.astro
//
// The map island. Owns the MapLibre instance and nothing else — panels talk to
// it through events, never by reaching for the map object.
//
// `isolate` on the container is LOAD-BEARING, not decorative. Markers get an
// inline z-index of their own so an overlapping pin can render above its
// neighbour, and `position: absolute` with no z-index does NOT create a
// stacking context — so without `isolate` those inline values are compared at
// the root level and win, painting map pins over the controls floating above
// the map. With it, "highest z-index" only ever means "highest among pins."
import MapThemeSelector from "~/components/ui/MapThemeSelector.astro";
---

<div class="absolute inset-0 isolate">
  <div id="map" class="h-full w-full"></div>
</div>

<MapThemeSelector />

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { Protocol } from "pmtiles";
  import { onReady } from "~/lib/domReady";
  import {
    IS_SELF_HOSTED,
    SELF_HOSTED_TILES_URL,
    getInitialMapStyle,
    onMapStyleChange,
  } from "~/lib/mapStyles";
  import { buildSelfHostedStyle } from "~/lib/selfHostedStyle";
  import {
    OFFLINE_PACK_CHANGE_EVENT,
    getActiveOfflineStyle,
    setOfflineProtocol,
  } from "~/lib/offlineMap";
  import { SEA_DEFAULT_VIEW } from "~/data/seaCountries.mjs";
  import { getActiveTheme, onSiteThemeChange } from "~/lib/siteTheme";

  /*
    Module scope, not function scope — see the teardown at the top of initMap.
    `onReady` runs init again on `astro:page-load`, which replaces the DOM: a
    subscription created in a previous run would still close over the old,
    destroyed map and throw on the next theme change, and the old map's WebGL
    context would leak.
  */
  let map: maplibregl.Map | null = null;
  let cleanups: (() => void)[] = [];

  /*
    ONE Protocol instance for the whole page, module-scoped like `map` above —
    not one per initMap() run. maplibregl.addProtocol binds a single handler
    function (protocol.tile) globally; creating a second Protocol on re-init
    (e.g. astro:page-load) would leave that old handler pointing at the first
    instance's registry forever, while offlineMap.ts registered packs onto the
    new one nothing ever consults. Unconditional now, not just for self-hosted
    — an offline pack needs `pmtiles://` exactly as much as a streamed archive
    does, just resolving to a local FileSource instead of a byte-range fetch.
  */
  const pmtilesProtocol = new Protocol();
  let protocolRegistered = false;
  function registerPmtilesProtocol(): void {
    if (!protocolRegistered) {
      maplibregl.addProtocol("pmtiles", pmtilesProtocol.tile);
      protocolRegistered = true;
    }
    setOfflineProtocol(pmtilesProtocol);
  }

  /*
    Offline-first: a downloaded pack outranks everything else, because it is
    the one source that keeps working with no connection at all — the whole
    point of this map. Falls through to the self-hosted stream, then the
    online vendor, exactly as before.
  */
  async function styleFor(): Promise<maplibregl.StyleSpecification | string> {
    const offline = await getActiveOfflineStyle(getActiveTheme());
    if (offline) return offline.style;
    return IS_SELF_HOSTED
      ? buildSelfHostedStyle(SELF_HOSTED_TILES_URL, getActiveTheme())
      : getInitialMapStyle().url;
  }

  async function initMap(): Promise<void> {
    // Tear down whatever a previous run left behind before touching the DOM.
    while (cleanups.length > 0) cleanups.pop()?.();
    map?.remove();
    map = null;

    const container = document.getElementById("map");
    if (!container) return;

    registerPmtilesProtocol();

    map = new maplibregl.Map({
      container,
      style: await styleFor(),
      center: SEA_DEFAULT_VIEW.center as [number, number],
      zoom: SEA_DEFAULT_VIEW.zoom,
      // The DOM record list beside the canvas is the primary screen-reader
      // interface; the canvas itself should not be a tab stop that traps focus.
      attributionControl: { compact: true },
    });

    // Mounted into MapLibre's own bottom-right corner, whose offsets global.css
    // repoints at the shared --map-ctrl-* variables so this stack and
    // MapThemeSelector can never drift out of alignment.
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "bottom-right");

    /*
      Re-resolve the whole style, not just repaint: a theme switch, a pack
      finishing download, or the visitor picking a different downloaded
      country all have to re-run the same offline-first > self-hosted > online
      decision above, since which branch applies can change (an offline pack
      exists now where it didn't a second ago).
    */
    async function restyle(theme: "light" | "dark"): Promise<void> {
      const offline = await getActiveOfflineStyle(theme);
      if (offline) {
        map?.setStyle(offline.style);
        return;
      }
      if (IS_SELF_HOSTED) {
        map?.setStyle(buildSelfHostedStyle(SELF_HOSTED_TILES_URL, theme));
      }
      // Online vendor mode keeps its own onMapStyleChange subscription below —
      // it swaps basemaps by id, not by re-deriving from theme.
    }

    cleanups.push(
      onSiteThemeChange((theme) => {
        restyle(theme);
      }),
    );

    const onOfflinePackChange = () => restyle(getActiveTheme());
    document.addEventListener(OFFLINE_PACK_CHANGE_EVENT, onOfflinePackChange);
    cleanups.push(() => document.removeEventListener(OFFLINE_PACK_CHANGE_EVENT, onOfflinePackChange));

    if (!IS_SELF_HOSTED) {
      cleanups.push(
        onMapStyleChange((option) => {
          // A pack downloaded mid-session still wins; only fall through to the
          // vendor basemap choice when there is truly nothing offline active.
          getActiveOfflineStyle(getActiveTheme()).then((offline) => {
            if (!offline) map?.setStyle(option.url);
          });
        }),
      );
    }
  }

  onReady(initMap);
</script>
